# Server-side settings for Vercel (Project > Settings > Environment Variables).
# Never prefix these with VITE_: that would put them inside the page for anyone to read.
# Copy this file to .env for your own notes; .env is git-ignored. Never put real values here.

# Apps Script web app URL (Deploy > Manage deployments), ending in /exec
GAS_URL=https://script.google.com/macros/s/XXXXXXXXXXXX/exec

# Same value as the SYNC_TOKEN Script Property in Apps Script
SYNC_TOKEN=

# The password people type to open the app. Use a long one.
APP_PASSWORD=
